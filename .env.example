# Copia este archivo como .env y llena los valores de tu proyecto de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > Configuración del SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional: clave de sitio de reCAPTCHA v3 para App Check (ver docs/seguridad.md). Vacía = App Check apagado.
VITE_APPCHECK_SITE_KEY=
