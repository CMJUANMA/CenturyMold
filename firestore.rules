rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isAuth()      { return request.auth != null; }
    function perfilPath()  { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function tienePerfil() { return isAuth() && exists(perfilPath()); }
    function perfil()      { return get(perfilPath()).data; }
    function activo()      { return tienePerfil() && perfil().get('activo', true) != false; }
    function rol()         { return perfil().get('rol', ''); }

    // Rol del SISTEMA (usuarios/{uid}.rol): solo admin, rh o usuario. Los permisos operativos (Aut. 2, Aut. 1, solicitante)
    // son asignaciones por área con vigencia (colección asignaciones); el puesto no da permisos.
    function esAdmin()        { return activo() && rol() == 'admin'; }
    function esRH()           { return activo() && rol() in ['rh', 'admin']; }
    function miNomina()       { return perfil().get('nomina', ''); }

    // ---------- Asignaciones (roles operativos) ----------
    // asignaciones/{nomina}_{rol}_{areaId|planta}. Vigente = activo, desde <= ahora y (sin hasta o ahora <= hasta).
    // Cada comprobación lee perfil + asignación (las lecturas repetidas del mismo documento no suman al límite de 10).
    function asigPath(rol, area) {
      return /databases/$(database)/documents/asignaciones/$(miNomina() + '_' + rol + '_' + area);
    }
    function asigVigente(a) {
      return a.get('activo', false) == true && a.desde <= request.time
        && (a.get('hasta', null) == null || request.time <= a.hasta);
    }
    function asignacionVigente(rol, area) {
      return activo() && miNomina() != '' && area is string && exists(asigPath(rol, area)) && asigVigente(get(asigPath(rol, area)).data);
    }
    function esAut2() { return asignacionVigente('aut2', 'planta'); }
    function esAut1De(areaId)        { return asignacionVigente('aut1', areaId); }
    function esSolicitanteDe(areaId) { return asignacionVigente('solicitante', areaId); }

    // Áreas: { nombre, participaTE, activa, orden }
    function areaPath(areaId) { return /databases/$(database)/documents/areas/$(areaId); }
    function areaActiva(areaId) {
      return areaId is string && exists(areaPath(areaId)) && get(areaPath(areaId)).data.get('activa', true) != false;
    }
    function areaParticipaTE(areaId) { return areaActiva(areaId) && get(areaPath(areaId)).data.get('participaTE', false) == true; }

    function cambia(campos)     { return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos); }
    function soloCambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    // ---------- Usuarios ----------
    match /usuarios/{uid} {
      // Cada quien lee su propio perfil (AuthContext); RH lee todos
      // La Aut. 2 también los lee: necesita saber quién aún no tiene usuario al asignar roles
      allow read: if (isAuth() && request.auth.uid == uid) || esRH() || esAut2();
      // Solo admin da o quita los roles rh y admin: RH crea usuarios con rol 'usuario'
      allow create: if esAdmin() || (esRH() && request.resource.data.rol == 'usuario');
      // RH edita a los usuarios que no son rh/admin y solo los deja en 'usuario' (un rol anterior sin migrar puede conservarse)
      allow update: if esAdmin()
        || (esRH() && !(resource.data.rol in ['rh', 'admin'])
            && (request.resource.data.rol == 'usuario' || request.resource.data.rol == resource.data.rol)
            && !(request.resource.data.rol in ['rh', 'admin']))
        // Primer acceso: el propio usuario solo puede bajar debeCambiarPassword de true a false (nunca al revés)
        || (activo() && request.auth.uid == uid
            && soloCambia(['debeCambiarPassword'])
            && resource.data.get('debeCambiarPassword', false) == true
            && request.resource.data.debeCambiarPassword == false)
        // Configuración personal: cada usuario cambia SOLO el campo preferencias de su propio documento
        || (activo() && request.auth.uid == uid
            && soloCambia(['preferencias'])
            && preferenciasValidas(request.resource.data.preferencias));
      // preferencias: { ayudas: bool, tamanoLetra: 'normal'|'grande', tema: 'claro'|'oscuro'|'auto', recorridosVistos: [ids] }
      function preferenciasValidas(p) {
        return p is map && p.keys().hasOnly(['ayudas', 'tamanoLetra', 'tema', 'recorridosVistos'])
          && p.get('ayudas', true) is bool
          && p.get('tamanoLetra', 'normal') in ['normal', 'grande']
          && p.get('tema', 'auto') in ['claro', 'oscuro', 'auto']
          && p.get('recorridosVistos', []) is list && p.get('recorridosVistos', []).size() <= 20;
      }
      // Borrar: el admin. RH solo para "Restablecer acceso": el perfil de un «usuario» (nunca el propio ni el de otro rh/admin) se borra
      // únicamente si en el MISMO lote se crea su perfil nuevo y su renglón de bitácora 'restablecer-{uid}' (ver `restablece`).
      allow delete: if esAdmin()
        || (esRH() && request.auth.uid != uid && resource.data.get('rol', '') == 'usuario' && restablece(uid));
      // El perfil se mueve al uid nuevo: misma nómina y mismo rol, que ya no existía, con debeCambiarPassword en true (contraseña temporal).
      // La bitácora (despues.uid) dice cuál es el uid nuevo; su alta la valida la regla de /bitacora (quién lo hizo y cuándo).
      function restablece(uid) {
        let bit = /databases/$(database)/documents/bitacora/$('restablecer-' + uid);
        let nuevoUid = getAfter(bit).data.despues.uid;
        let nuevo = /databases/$(database)/documents/usuarios/$(nuevoUid);
        return !exists(bit) && existsAfter(bit)
          && getAfter(bit).data.accion == 'restablecer_acceso' && getAfter(bit).data.antes.uid == uid
          && nuevoUid is string && nuevoUid != uid
          && !exists(nuevo) && existsAfter(nuevo)
          && getAfter(nuevo).data.nomina == resource.data.nomina
          && getAfter(nuevo).data.rol == resource.data.rol
          && getAfter(nuevo).data.get('debeCambiarPassword', false) == true;
      }
    }

    // ---------- Catálogos ----------
    // Estructura ÁREAS → PUESTOS → EMPLEADOS (ver docs/estructura.md). Las bajas son lógicas (activa/activo: false):
    // nadie borra. Que un área no tenga puestos activos al darla de baja lo valida la pantalla (una regla no puede consultarlo).
    match /areas/{id} {
      allow read: if activo();
      allow create, update: if esRH()
        && request.resource.data.nombre is string && request.resource.data.nombre.trim().size() > 0
        && request.resource.data.get('participaTE', false) is bool
        && request.resource.data.get('activa', true) is bool
        && request.resource.data.get('orden', 0) is number;
      allow delete: if false;
    }
    match /puestos/{id} {
      function p() { return request.resource.data; }
      function puestoValido() {
        return p().nombre is string && p().nombre.size() > 0 && p().nombre == p().nombre.upper()
          && p().areaId is string && p().activo is bool && p().alias is list
          // nivelJerarquico (opcional): entero >= 1, 1 = el puesto más alto; ordena el organigrama
          && (!p().keys().hasAny(['nivelJerarquico']) || (p().nivelJerarquico is int && p().nivelJerarquico >= 1));
      }
      allow read: if activo();
      allow create: if esRH() && puestoValido()
        && p().creadoPor == request.auth.uid && p().fechaCreacion == request.time;
      allow update: if esRH() && puestoValido()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fechaCreacion', 'creadoPor']);
      allow delete: if false;
    }
    // Bitácora: solo se crea. La leen y la crean admin y RH; la Aut. 2 solo lo de asignaciones (ella también asigna).
    // El Aut. 1 y el solicitante NO la leen: ahí queda quién asignó a quién y cuándo. Nadie la edita ni la borra.
    match /bitacora/{id} {
      allow read: if esRH() || (esAut2() && resource.data.get('entidad', '') == 'asignacion');
      allow create: if (esRH() || (esAut2() && request.resource.data.entidad == 'asignacion'))
        && request.resource.data.keys().hasOnly(['accion', 'entidad', 'antes', 'despues', 'porUid', 'porNombre', 'fecha'])
        && request.resource.data.accion is string && request.resource.data.entidad is string
        && request.resource.data.porUid == request.auth.uid
        && request.resource.data.fecha == request.time;
      allow update, delete: if false;
    }
    match /rutas/{id}         { allow read: if activo(); allow write: if esRH(); }
    match /comunidades/{id}   { allow read: if activo(); allow write: if esRH(); }
    match /puntosReunion/{id} { allow read: if activo(); allow write: if esRH(); }
    // Colección heredada (mayúscula) usada solo por Diagnóstico/migración de RH
    match /PuntosReunion/{id} { allow read, write: if esRH(); }

    // ---------- Empleados ----------
    match /empleados/{id} {
      // Cualquier usuario activo lo lee (padrón). puestoId, areaId, areaExcepcion(+Motivo) y el resto solo los cambian
      // Lo leen admin, RH y la Aut. 2 (todo el padrón); un solicitante o Aut. 1 vigente, solo los empleados de sus áreas.
      // Las consultas de estos dos roles deben traer where('areaId', '==' o 'in', sus áreas): una regla no puede probar
      // el área de cada documento de una consulta abierta (con 'in', si alguna área no es suya se rechaza toda).
      // La lista blanca de abajo para quien no es RH solo incluye ruta/comunidad/punto, y solo de empleados
      // del área donde es solicitante vigente (la pantalla solo manda esos cambios al padrón)
      allow read: if esRH() || esAut2()
        || (activo() && (esSolicitanteDe(resource.data.get('areaId', null)) || esAut1De(resource.data.get('areaId', null))));
      allow create: if esRH();
      allow update: if esRH()
        || (soloCambia(['rutaId', 'comunidadId', 'puntoReunionId'])
            && (esSolicitanteDe(resource.data.get('areaId', null)) || esAut1De(resource.data.get('areaId', null))));
      allow delete: if esRH();
    }

    // ---------- Solicitudes ----------
    match /solicitudes/{solId} {
      function esDueno() { return resource.data.creadoPor == request.auth.uid; }
      // RH/admin, o solicitante vigente del área de la solicitud. Las solicitudes anteriores (sin areaId) siguen
      // funcionando para quien las creó. d = datos de la solicitud
      function puedeSobre(d) {
        return esRH() || (activo() && (d.get('areaId', null) == null || esSolicitanteDe(d.areaId)));
      }

      // Cada quien lee las suyas aunque su rol de solicitante ya haya vencido. La solicitud de transporte que RH genera al recibir un
      // tiempo extra la lee quien puede leer ese tiempo extra (su solicitante y su Aut. 1 ven el estatus del transporte)
      allow read: if esRH() || (activo() && esDueno())
        || (activo() && resource.data.get('origen', '') == 'tiempo_extra'
            && puedeLeerTE(get(/databases/$(database)/documents/tiempoExtra/$(resource.data.tiempoExtraId)).data));
      // Las solicitudes de transporte sueltas las crean solo RH y admin (los solicitantes piden transporte dentro del
      // tiempo extra). Las anteriores de cada usuario siguen visibles para él, y editables mientras sea solicitante vigente de su área.
      // Las de origen 'tiempo_extra' las genera RH al recibir un tiempo extra autorizado: nacen aprobadas y el mismo lote/transacción
      // debe pasar ese tiempo extra a procesada apuntando a ellas (getAfter). Ninguna otra solicitud puede traer 'origen'.
      function transporteDeTE() {
        let d = request.resource.data;
        let te = /databases/$(database)/documents/tiempoExtra/$(d.tiempoExtraId);
        return d.origen == 'tiempo_extra' && d.estatus == 'aprobada' && d.tiempoExtraId is string
          && d.keys().hasOnly(['fechaSolicitud', 'fechaServicio', 'solicitanteNombre', 'solicitanteNomina', 'creadoPor', 'creadoPorNombre',
                               'areaId', 'estatus', 'origen', 'tiempoExtraId', 'folioTE', 'totalPasajeros', 'totalAlimentos',
                               'conteoTurnos', 'conteoPuestos', 'historial', 'revisadoPor', 'revisadoPorNombre', 'fechaRevision'])
          && d.fechaSolicitud == request.time
          && get(te).data.estatus == 'autorizada'
          && getAfter(te).data.estatus == 'procesada'
          && getAfter(te).data.get('solicitudTransporteId', null) == solId
          && d.fechaServicio == get(te).data.fechaTE
          && d.areaId == get(te).data.areaId
          && d.folioTE == get(te).data.get('folio', '');
      }
      allow create: if esRH()
        && request.resource.data.creadoPor == request.auth.uid
        && ((request.resource.data.get('origen', null) == null && request.resource.data.estatus == 'pendiente')
            || transporteDeTE());
      allow update: if esRH()
        // Dueño: cancelar o editar (una aprobada vuelve a pendiente). Lista blanca de campos:
        // lo que escribe EditarSolicitud (fechaServicio, solicitanteNombre, el resumen de pasajeros:
        // totalPasajeros/totalAlimentos/conteoTurnos/conteoPuestos, estatus, modificada, historial) y la cancelación (estatus, historial). creadoPor, fechaSolicitud y
        // los campos de revisión de RH quedan fuera.
        || (esDueno() && puedeSobre(resource.data)
            && resource.data.estatus in ['pendiente', 'aprobada']
            && request.resource.data.estatus in ['pendiente', 'cancelada']
            && soloCambia(['fechaServicio', 'solicitanteNombre', 'totalPasajeros', 'totalAlimentos', 'conteoTurnos', 'conteoPuestos',
                        'estatus', 'modificada', 'historial']))
        // Dueño: marcar como vista y avisar a RH, en cualquier estatus
        || (activo() && esDueno()
            && soloCambia(['vistoPorSolicitante', 'historial']));
      allow delete: if esAdmin();

      match /pasajeros/{pasId} {
        function padreAntes()   { return get(/databases/$(database)/documents/solicitudes/$(solId)).data; }
        // getAfter: en el batch de creación la solicitud padre aún no existe en el estado "antes"
        function padreDespues() { return getAfter(/databases/$(database)/documents/solicitudes/$(solId)).data; }

        allow read: if esRH() || (activo() && padreAntes().creadoPor == request.auth.uid);
        allow write: if esRH()
          || (activo()
              && padreDespues().creadoPor == request.auth.uid
              && padreDespues().estatus == 'pendiente'
              && (padreDespues().get('areaId', null) == null || esSolicitanteDe(padreDespues().areaId)));
      }
    }

    // =====================================================================
    // TIEMPO EXTRA  (ver docs/tiempo-extra.md)
    // Los niveles salen de asignacionVigente (arriba): Aut. 1 y solicitante por área, Aut. 2 de toda la planta.
    // =====================================================================

    // La Aut. 2 la firma un Aut. 2 vigente o RH (RH solo firma en este nivel)
    function puedeFirmarAut2() { return esAut2() || esRH(); }

    // Quién captura en un área: un solicitante o el Aut. 1 vigente de esa área (el Aut. 1 captura y su solicitud se salta
    // su propio nivel); en un área que no participa en TE (Administrativo) solo RH o un Aut. 2
    function puedeCapturarTE(areaId) {
      return areaActiva(areaId) && (areaParticipaTE(areaId) ? (esSolicitanteDe(areaId) || esAut1De(areaId)) : (esRH() || esAut2()));
    }
    // Folio asignado al enviar: TE-AAAA-NNNN, con el número que deja el contador del año en el mismo lote/transacción
    // (el contador debe subir exactamente 1; así los borradores no gastan folios y no hay folios repetidos)
    function folioDelContador(folio) {
      return folio.matches('TE-[0-9]{4}-[0-9]{4,}')
        && folio.split('-')[1] == string(request.time.year())
        && getAfter(/databases/$(database)/documents/contadores/$('te-' + string(request.time.year()))).data.ultimo == int(folio.split('-')[2])
        && (exists(/databases/$(database)/documents/contadores/$('te-' + string(request.time.year())))
            ? get(/databases/$(database)/documents/contadores/$('te-' + string(request.time.year()))).data.ultimo : 0) + 1 == int(folio.split('-')[2]);
    }
    // Al capturar o reenviar, el Aut. 1 de esa área se salta su propio nivel; en un área que no participa se va directo a Aut. 2
    function estatusInicial(areaId) {
      return (!areaParticipaTE(areaId) || esAut1De(areaId)) ? 'pendiente_aut2' : 'pendiente_aut1';
    }

    // t = datos de una solicitud de tiempo extra. Un borrador solo lo ve su creador
    function puedeLeerTE(t) {
      return activo() && (t.creadoPor == request.auth.uid
        || (t.estatus != 'borrador' && (esAut1De(t.areaId) || esAut2() || esRH())));
    }
    // Firma o devolución bien formada: {nomina, nombre, fecha, ...} de quien la hace
    // comoRH: true si firma el nivel 2 por su rol RH/admin (sin ser Aut. 2); así se sabe si firmó la Aut. 2 o alguien de RH
    function firmaValida(f, comoRH) {
      return f.nomina == miNomina() && f.fecha == request.time && f.get('comoRH', false) == comoRH;
    }
    // Devolver exige un motivo de al menos 10 caracteres
    function devolucionValida(d, nivel) {
      return d.nivel == nivel && d.nomina == miNomina() && d.fecha == request.time
        && d.motivo is string && d.motivo.trim().size() >= 10;
    }

    // Asignaciones: las lee cualquier usuario activo; las escribe admin (cualquier rol) o RH / Aut. 2 (solo aut1 y solicitante,
    // de un área con participaTE). Nadie, salvo admin, toca las suyas. Nunca se borran: revocar es activo:false.
    match /asignaciones/{asigId} {
      function n() { return request.resource.data; }
      function idEsperado(d) { return d.nomina + '_' + d.rol + '_' + (d.rol == 'aut2' ? 'planta' : d.areaId); }
      function formaValida() {
        // puesto y puestoId (copia del padrón) son opcionales: las asignaciones anteriores no los traen
        return n().keys().hasOnly(['nomina', 'nombre', 'puesto', 'puestoId', 'rol', 'areaId', 'desde', 'hasta', 'motivo', 'activo', 'asignadoPor', 'fechaAsignacion'])
          && n().keys().hasAll(['nomina', 'nombre', 'rol', 'areaId', 'desde', 'hasta', 'motivo', 'activo', 'asignadoPor', 'fechaAsignacion'])
          && n().nomina is string && n().nomina.size() > 0 && n().nombre is string
          && n().get('puesto', '') is string && n().get('puestoId', '') is string
          && n().rol in ['aut2', 'aut1', 'solicitante']
          && (n().rol == 'aut2' ? n().areaId == null : n().areaId is string)
          && asigId == idEsperado(n())
          && n().desde is timestamp
          && (n().hasta == null || (n().hasta is timestamp && n().hasta >= n().desde))
          && n().motivo is string && (n().hasta == null || n().motivo.trim().size() > 0)
          && n().activo is bool
          && n().asignadoPor is map && n().asignadoPor.uid is string;
      }
      // d = una asignación (la que había o la nueva): ¿puede esta persona darla o cambiarla?
      function puedeAsignar(d) {
        return esAdmin()
          || (d.rol in ['aut1', 'solicitante'] && (esRH() || esAut2())
              && d.nomina != miNomina() && areaParticipaTE(d.areaId));
      }

      // Cada quien lee las suyas; el Aut. 1, las de su área y las de Aut. 2 (el Nivel 2 que ve arriba en su organigrama);
      // Aut. 2, RH y admin, todas. El solicitante, ademas, los Aut. 1 de su área. Las consultas deben probarse: where('nomina' == la suya), where('areaId' == su área) o where('rol' == 'aut2'); la del solicitante agrega where('rol' == 'aut1')
      allow read: if esRH() || esAut2()
        || (activo() && (resource.data.nomina == miNomina() || resource.data.rol == 'aut2' || esAut1De(resource.data.areaId)))
        // El solicitante lee los Aut. 1 de su área: la pantalla le recuerda a quién avisar al enviar su solicitud
        || (resource.data.rol == 'aut1' && esSolicitanteDe(resource.data.areaId));
      allow create: if formaValida() && puedeAsignar(n()) && n().activo == true
        && n().fechaAsignacion == request.time && n().asignadoPor.uid == request.auth.uid;
      // Cada transición es su propio "allow update" (se evalúan en OR) y comprueba lo mínimo: una regla tiene tope de 1000 expresiones.
      // Revocar o extender: solo activo, hasta, motivo (la persona, el rol y el área no cambian,
      // así que basta probar una vez quién puede asignar ese rol); lo que se escribe debe seguir siendo válido
      function cambioValido() {
        return n().activo is bool
          && (n().hasta == null || (n().hasta is timestamp && n().hasta >= n().desde))
          && n().motivo is string && (n().hasta == null || n().motivo.trim().size() > 0);
      }
      allow update: if soloCambia(['activo', 'hasta', 'motivo']) && cambioValido() && puedeAsignar(resource.data);
      // Volver a asignar: el documento completo, con fecha y autor nuevos
      allow update: if formaValida() && n().activo == true && n().fechaAsignacion == request.time && n().asignadoPor.uid == request.auth.uid
        && n().nomina == resource.data.nomina && n().rol == resource.data.rol && n().areaId == resource.data.areaId
        && puedeAsignar(resource.data) && puedeAsignar(n());
      // Copiar nombre, puesto y puestoId del padrón (botón del admin e importación del padrón por RH): solo esos campos, de cualquier rol
      allow update: if esRH() && soloCambia(['nombre', 'puesto', 'puestoId'])
        && n().nombre is string && n().get('puesto', '') is string && n().get('puestoId', '') is string;
      allow delete: if false;
    }

    // (areasTE, config/* y accesosTE ya no tienen reglas: la estructura anterior quedó sin acceso desde la app.)

    // Turnos de nómina (A, B, C): horario normal de cada uno. Los lee cualquier usuario activo (la extensión de turno parte del fin de turno);
    // los captura RH o admin. Un horario vacío es "sin configurar".
    match /turnosNomina/{turno} {
      function t() { return request.resource.data; }
      function hora(h) { return h in ['', '7:00', '16:00', '19:00', '0:00']; }
      allow read: if activo();
      allow create, update: if esRH() && turno in ['A', 'B', 'C']
        && t().keys().hasOnly(['turno', 'entrada', 'salida', 'actualizadoPor', 'fechaActualizacion'])
        && t().turno == turno && hora(t().entrada) && hora(t().salida)
        && t().actualizadoPor.uid == request.auth.uid && t().fechaActualizacion == request.time;
      allow delete: if false;
    }

    // Contador del folio (TE-2026-0001): se incrementa de uno en uno dentro de la transacción de captura
    // El contador solo sube de uno en uno y SOLO dentro del mismo lote/transacción en que una solicitud propia pasa de borrador a
    // pendiente con ese folio: `solicitudId` apunta a ella y se comprueba antes (get) y después (getAfter). Subirlo aislado falla.
    match /contadores/{id} {
      function folioLigado() {
        let sid = request.resource.data.solicitudId;
        return sid is string
          && get(/databases/$(database)/documents/tiempoExtra/$(sid)).data.estatus == 'borrador'
          && get(/databases/$(database)/documents/tiempoExtra/$(sid)).data.creadoPor == request.auth.uid
          && getAfter(/databases/$(database)/documents/tiempoExtra/$(sid)).data.estatus in ['pendiente_aut1', 'pendiente_aut2']
          && getAfter(/databases/$(database)/documents/tiempoExtra/$(sid)).data.folio.split('-')[1] == id.split('-')[1]
          && int(getAfter(/databases/$(database)/documents/tiempoExtra/$(sid)).data.folio.split('-')[2]) == request.resource.data.ultimo;
      }
      allow read: if activo();
      allow create: if activo() && id.matches('te-[0-9]{4}')
        && request.resource.data.keys().hasOnly(['ultimo', 'solicitudId']) && request.resource.data.ultimo == 1 && folioLigado();
      allow update: if activo() && id.matches('te-[0-9]{4}')
        && request.resource.data.keys().hasOnly(['ultimo', 'solicitudId']) && request.resource.data.ultimo == resource.data.ultimo + 1 && folioLigado();
    }

    match /tiempoExtra/{teId} {
      function uid() { return request.auth.uid; }
      function antes()   { return resource.data; }
      function despues() { return request.resource.data; }
      allow read: if puedeLeerTE(resource.data);

      // Tipo de tiempo extra: turno extra (viene a la planta) o extensión de turno (ya está en la planta)
      function tipoValido() { return despues().get('tipo', 'turno_extra') in ['turno_extra', 'extension']; }
      // Cada ruta adicional cuesta: con más de una ruta hay que justificarlo (15+ caracteres) para poder enviar
      function rutasJustificadas() {
        return despues().get('rutasDistintas', 0) is number
          && (despues().get('rutasDistintas', 0) <= 1
              || (despues().get('justificacionRutas', '') is string && despues().get('justificacionRutas', '').trim().size() >= 15));
      }

      // Motivo "Otro": motivoOtro (¿Cuál?) solo existe con ese motivo, es texto de hasta 60 caracteres y, al enviar, de al menos 3
      function motivoOtroValido() {
        return despues().motivo == 'Otro'
          ? (!despues().keys().hasAny(['motivoOtro'])
              || (despues().motivoOtro is string && despues().motivoOtro.trim().size() <= 60 && despues().motivoOtro.size() <= 60))
          : !despues().keys().hasAny(['motivoOtro']);
      }
      function motivoOtroCompleto() {
        return despues().motivo != 'Otro'
          || (despues().get('motivoOtro', '') is string && despues().get('motivoOtro', '').trim().size() >= 3);
      }

      // Toda solicitud nace como BORRADOR: id propio (BR-…), sin folio y sin firmas, a nombre de quien la crea. Solo un solicitante
      // o el Aut. 1 vigente del área (RH o Aut. 2 si el área no participa en TE). El folio se asigna al enviarla
      allow create: if activo()
        && teId.matches('BR-[A-Za-z0-9]{10,}')
        && despues().keys().hasOnly(['areaId', 'areaNombre', 'creadoPor', 'creadoPorNomina', 'creadoPorNombre',
                                     'fechaTE', 'motivo', 'motivoOtro', 'comentario', 'estatus', 'resumen', 'tipo', 'rutasDistintas', 'desgloseRutas', 'justificacionRutas',
                                     'fechaCreacion', 'fechaActualizacion'])
        && despues().keys().hasAll(['areaId', 'creadoPor', 'creadoPorNomina', 'fechaTE', 'motivo', 'estatus',
                                    'fechaCreacion', 'fechaActualizacion'])
        && despues().estatus == 'borrador'
        && tipoValido() && motivoOtroValido()
        && despues().creadoPor == uid()
        && despues().creadoPorNomina == miNomina()
        && despues().areaId is string
        && puedeCapturarTE(despues().areaId)
        && despues().fechaCreacion == request.time
        && despues().fechaActualizacion == request.time;

      // Cada transición es su propio "allow update" (se evalúan en OR). Primero se comparan los datos
      // (estatus antes/después, campos que cambian) y al final los roles, que leen el perfil y la matriz.

      // Aut. 1 vigente de esa área autoriza: pendiente_aut1 → pendiente_aut2. Nadie autoriza lo que creó.
      allow update: if antes().estatus == 'pendiente_aut1' && despues().estatus == 'pendiente_aut2'
        && despues().fechaActualizacion == request.time
        && soloCambia(['estatus', 'aut1', 'fechaActualizacion'])
        && antes().creadoPor != uid()
        && esAut1De(antes().areaId) && firmaValida(despues().aut1, false);

      // Aut. 1 devuelve (con motivo): pendiente_aut1 → devuelta
      allow update: if antes().estatus == 'pendiente_aut1' && despues().estatus == 'devuelta'
        && despues().fechaActualizacion == request.time
        && soloCambia(['estatus', 'devolucion', 'fechaActualizacion'])
        && antes().creadoPor != uid()
        && esAut1De(antes().areaId) && devolucionValida(despues().devolucion, 1);

      // Aut. 2 vigente o RH autorizan: pendiente_aut2 → autorizada (si la creó un Aut. 2, la firma otro Aut. 2 o RH)
      allow update: if antes().estatus == 'pendiente_aut2' && despues().estatus == 'autorizada'
        && despues().fechaActualizacion == request.time
        && soloCambia(['estatus', 'aut2', 'fechaActualizacion'])
        && antes().creadoPor != uid()
        && puedeFirmarAut2() && firmaValida(despues().aut2, !esAut2());

      // ...o devuelven (con motivo): pendiente_aut2 → devuelta
      allow update: if antes().estatus == 'pendiente_aut2' && despues().estatus == 'devuelta'
        && despues().fechaActualizacion == request.time
        && soloCambia(['estatus', 'devolucion', 'fechaActualizacion'])
        && antes().creadoPor != uid()
        && puedeFirmarAut2() && devolucionValida(despues().devolucion, 2);

      // RH la recibe: autorizada → procesada, con la solicitud de transporte creada en la MISMA operación (getAfter) y apuntando a este
      // tiempo extra; si nadie pidió transporte, no lleva solicitud. Solo RH y admin (la Aut. 2 que no es RH no recibe).
      function transporteGenerado(sid) {
        let p = /databases/$(database)/documents/solicitudes/$(sid);
        return existsAfter(p) && !exists(p)
          && getAfter(p).data.get('origen', '') == 'tiempo_extra'
          && getAfter(p).data.get('tiempoExtraId', '') == teId;
      }
      allow update: if antes().estatus == 'autorizada' && despues().estatus == 'procesada'
        && despues().fechaActualizacion == request.time
        && soloCambia(['estatus', 'recibidaPor', 'fechaRecepcion', 'solicitudTransporteId', 'fechaActualizacion'])
        && despues().fechaRecepcion == request.time
        && despues().recibidaPor.keys().hasOnly(['nomina', 'nombre', 'fecha'])
        && despues().recibidaPor.nomina == miNomina() && despues().recibidaPor.fecha == request.time
        && (despues().get('solicitudTransporteId', null) != null
            ? transporteGenerado(despues().solicitudTransporteId)
            : antes().resumen.get('totalTransporte', 0) == 0)
        && esRH();

      // RH devuelve en la recepción (con motivo de 10+ caracteres, nivel 3): autorizada → devuelta
      allow update: if antes().estatus == 'autorizada' && despues().estatus == 'devuelta'
        && despues().fechaActualizacion == request.time
        && soloCambia(['estatus', 'devolucion', 'fechaActualizacion'])
        && esRH() && devolucionValida(despues().devolucion, 3);

      // RH cancela lo autorizado o ya recibido, con motivo (10+ caracteres). Si ya había generado transporte, esa solicitud queda en la
      // misma operación cancelada o marcada para revisión (si ya se envió al proveedor): nada a medias
      function transporteResuelto(sid) {
        let p = /databases/$(database)/documents/solicitudes/$(sid);
        return getAfter(p).data.estatus == 'cancelada' || getAfter(p).data.get('requiereRevision', false) == true;
      }
      allow update: if antes().estatus in ['autorizada', 'procesada'] && despues().estatus == 'cancelada'
        && despues().fechaActualizacion == request.time
        && soloCambia(['estatus', 'motivoCancelacion', 'canceladaPor', 'fechaActualizacion'])
        && despues().motivoCancelacion is string && despues().motivoCancelacion.trim().size() >= 10
        && despues().canceladaPor.keys().hasOnly(['nomina', 'nombre', 'fecha', 'comoRH'])
        && despues().canceladaPor.nomina == miNomina() && despues().canceladaPor.fecha == request.time
        && (antes().get('solicitudTransporteId', null) == null || transporteResuelto(antes().solicitudTransporteId))
        && esRH();

      // El creador cancela mientras no esté autorizada, siempre con motivo (un borrador no se cancela: se elimina)
      allow update: if antes().estatus in ['pendiente_aut1', 'pendiente_aut2', 'devuelta'] && despues().estatus == 'cancelada'
        && despues().fechaActualizacion == request.time
        && soloCambia(['estatus', 'motivoCancelacion', 'fechaActualizacion'])
        && despues().motivoCancelacion is string && despues().motivoCancelacion.trim().size() >= 3
        && antes().creadoPor == uid() && activo();

      // El creador corrige el contenido de una devuelta (sin cambiar de estatus)
      // (y de un borrador, mientras se arma)
      allow update: if antes().estatus in ['devuelta', 'borrador'] && despues().estatus == antes().estatus
        && despues().fechaActualizacion == request.time
        && soloCambia(['fechaTE', 'motivo', 'motivoOtro', 'comentario', 'resumen', 'tipo', 'rutasDistintas', 'desgloseRutas', 'justificacionRutas', 'fechaActualizacion'])
        && tipoValido() && motivoOtroValido()
        && antes().creadoPor == uid() && activo();

      // Enviar a autorización: el borrador recibe su FOLIO (del contador, en el mismo lote), el resumen calculado y el estatus inicial
      // (pendiente_aut1, o pendiente_aut2 si es el Aut. 1 de esa área o el área no participa)
      allow update: if antes().estatus == 'borrador' && despues().estatus in ['pendiente_aut1', 'pendiente_aut2']
        && despues().fechaActualizacion == request.time
        && !despues().keys().hasAny(['aut1', 'aut2'])
        && soloCambia(['fechaTE', 'motivo', 'motivoOtro', 'comentario', 'resumen', 'tipo', 'rutasDistintas', 'desgloseRutas', 'justificacionRutas', 'estatus', 'folio', 'fechaActualizacion'])
        && tipoValido() && rutasJustificadas() && motivoOtroValido() && motivoOtroCompleto()
        && antes().creadoPor == uid()
        && puedeCapturarTE(antes().areaId)
        && despues().estatus == estatusInicial(antes().areaId)
        && folioDelContador(despues().folio);

      // ...y la devuelta se reenvía: vuelve a empezar (sin firmas) y conserva su folio
      allow update: if antes().estatus == 'devuelta' && despues().estatus in ['pendiente_aut1', 'pendiente_aut2']
        && despues().fechaActualizacion == request.time
        && !despues().keys().hasAny(['aut1', 'aut2'])
        && soloCambia(['fechaTE', 'motivo', 'motivoOtro', 'comentario', 'resumen', 'tipo', 'rutasDistintas', 'desgloseRutas', 'justificacionRutas', 'estatus', 'aut1', 'aut2', 'fechaActualizacion'])
        && tipoValido() && rutasJustificadas() && motivoOtroValido() && motivoOtroCompleto()
        && antes().creadoPor == uid()
        && puedeCapturarTE(antes().areaId)
        && despues().estatus == estatusInicial(antes().areaId);

      // Un borrador propio se elimina (antes se borran sus empleados, en lotes); lo demás solo lo borra el admin
      allow delete: if esAdmin() || (activo() && antes().estatus == 'borrador' && antes().creadoPor == uid());

      // Empleados incluidos: solo los escribe el creador (al capturar y mientras esté devuelta);
      // los autorizadores no los tocan. El id del documento es la nómina, y esa persona debe ser del área de la
      // solicitud en el padrón (empleados/{nomina}.areaId). Cada empleado cuesta una lectura del padrón en las reglas
      // (límite de 20 por lote): ver docs/tiempo-extra.md, "Límite de empleados por lote".
      match /empleados/{nomina} {
        function empleadoDelArea(areaId) {
          // get() sin exists(): si el empleado no está en el padrón, la lectura falla y la regla niega (y cuesta 1 lectura, no 2)
          return get(/databases/$(database)/documents/empleados/$(nomina)).data.get('areaId', '') == areaId;
        }
        function padrePath()    { return /databases/$(database)/documents/tiempoExtra/$(teId); }
        function padreAntes()   { return get(padrePath()).data; }
        // getAfter: en el lote de captura el padre aún no existe en el estado "antes"
        function padreDespues() { return getAfter(padrePath()).data; }

        allow read: if puedeLeerTE(padreAntes());
        function formaEmpleado() {
          return request.resource.data.keys().hasOnly(['nombre', 'puesto', 'turnoNomina', 'horaEntrada', 'horaSalida', 'horas',
                                                       'requiereAlimentos', 'requiereTransporte', 'transporteLlegada', 'transporteSalida', 'rutaId', 'comunidadId', 'puntoReunionId']);
        }
        function puedeEscribirEmpleado() {
          return activo()
          && padreDespues().creadoPor == uid()
          && (
            // el borrador se crea y se le agregan empleados en el mismo lote
            (!exists(padrePath()) && padreDespues().estatus == 'borrador')
            // corrección o armado: padre devuelta o borrador; puede reenviarse/enviarse en el mismo lote
            || (padreAntes().estatus in ['devuelta', 'borrador']
                && padreDespues().estatus in [padreAntes().estatus, 'pendiente_aut1', 'pendiente_aut2'])
          );
        }
        // En una extensión de turno el empleado ya está en la planta: no lleva transporte de llegada
        function llegadaPermitida() {
          return padreDespues().get('tipo', 'turno_extra') != 'extension' || request.resource.data.get('transporteLlegada', false) == false;
        }
        allow create, update: if puedeEscribirEmpleado() && formaEmpleado() && llegadaPermitida() && empleadoDelArea(padreDespues().areaId);
        allow delete: if puedeEscribirEmpleado();
      }

      // Bitácora: solo se crea, nunca se edita ni se borra. Cada acción debe acompañar la transición real
      // del padre en el mismo lote (estatus antes → después) y la hace quien tiene ese rol.
      match /historial/{hId} {
        function hPadrePath() { return /databases/$(database)/documents/tiempoExtra/$(teId); }
        function hAntes()     { return get(hPadrePath()).data; }
        function hDespues()   { return getAfter(hPadrePath()).data; }
        function h()          { return request.resource.data; }

        allow read: if puedeLeerTE(hAntes());
        allow create: if activo()
          && h().porUid == uid()
          && h().porNomina == miNomina()
          && h().fecha == request.time
          && (
            (h().accion == 'creada' && !exists(hPadrePath())
              && hDespues().creadoPor == uid() && hDespues().estatus == 'borrador')
            || (h().accion == 'reenviada' && hAntes().estatus == 'devuelta' && hAntes().creadoPor == uid()
              && hDespues().estatus in ['pendiente_aut1', 'pendiente_aut2'])
            || (h().accion == 'enviada' && hAntes().estatus == 'borrador' && hAntes().creadoPor == uid()
              && hDespues().estatus in ['pendiente_aut1', 'pendiente_aut2'])
            || (h().accion == 'autorizada_1' && esAut1De(hAntes().areaId)
              && hAntes().estatus == 'pendiente_aut1' && hDespues().estatus == 'pendiente_aut2')
            || (h().accion == 'autorizada_2' && puedeFirmarAut2()
              && hAntes().estatus == 'pendiente_aut2' && hDespues().estatus == 'autorizada')
            || (h().accion == 'devuelta' && hDespues().estatus == 'devuelta'
              && ((h().nivel == 1 && hAntes().estatus == 'pendiente_aut1' && esAut1De(hAntes().areaId))
                  || (h().nivel == 2 && hAntes().estatus == 'pendiente_aut2' && puedeFirmarAut2())
                  || (h().nivel == 3 && hAntes().estatus == 'autorizada' && esRH())))
            || (h().accion == 'cancelada' && hAntes().creadoPor == uid()
              && hAntes().estatus in ['pendiente_aut1', 'pendiente_aut2', 'devuelta'] && hDespues().estatus == 'cancelada')
            || (h().accion == 'cancelada' && esRH()
              && hAntes().estatus in ['autorizada', 'procesada'] && hDespues().estatus == 'cancelada')
            || (h().accion == 'recibida_rh' && esRH()
              && hAntes().estatus == 'autorizada' && hDespues().estatus == 'procesada')
          );
        allow update, delete: if false;
      }
    }

    // Sin regla general: todo lo que no esté listado arriba queda denegado.
  }
}
